# Public app URL — must match APP_URL in backend .env (use https://personnapress.com for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL (FastAPI running on DigitalOcean Droplet or locally)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Delivery token for the PersonnaPress company blog (create one in Settings → API Tokens; must be a read-only delivery token)
PERSONNAPRESS_DELIVERY_TOKEN=

# Email capture widget (Resend) — same API key as the backend; segment ID from Resend dashboard
RESEND_API_KEY=re_...
# Create a Segment in the Resend dashboard (Audiences are deprecated), then paste the UUID here
RESEND_SEGMENT_ID=your-resend-segment-id
