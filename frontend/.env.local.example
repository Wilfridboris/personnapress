# Public app URL — must match APP_URL in backend .env (use https://personnapress.com for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API URL (FastAPI running on DigitalOcean Droplet or locally)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Delivery token for the PersonnaPress company blog (create one in Settings → API Tokens; must be a read-only delivery token)
PERSONNAPRESS_DELIVERY_TOKEN=

# Email capture widget (Resend) — same API key as the backend; segment ID from Resend dashboard
RESEND_API_KEY=re_...
# Create a Segment in the Resend dashboard (Audiences are deprecated), then paste the UUID here
RESEND_SEGMENT_ID=your-resend-segment-id

# Server-side app URL (used in /api/auth/* route handlers for OAuth redirect URIs)
APP_URL=http://localhost:3000

# Meta platform publishing (flips to true when Meta Business App review is approved)
NEXT_PUBLIC_META_PUBLISHING_ENABLED=false
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
# Facebook Login for Business Configuration ID (16-digit number)
# 1. In Meta App Dashboard, add "Facebook Login for Business" product
# 2. Go to Configurations > + Create configuration (User access token, required permissions)
# 3. Permissions MUST include: instagram_basic, instagram_content_publish,
#    pages_show_list, pages_read_engagement, pages_manage_posts, business_management
#    (business_management is required for /me/accounts to return Business Portfolio pages)
# 4. Copy the Configuration ID shown after saving
NEXT_PUBLIC_META_OAUTH_CONFIG_ID=your-flfb-config-id
# Threads App (separate from Meta Business App — register at developers.facebook.com under Threads settings)
# Redirect URI: https://personnapress.com/api/auth/threads/callback
NEXT_PUBLIC_THREADS_APP_ID=your-threads-app-id
