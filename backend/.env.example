# Database — Supabase Postgres connection string (use asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# AES-256-GCM key for encrypting platform credentials (must be exactly 32 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CREDENTIAL_ENCRYPTION_KEY=your-32-char-encryption-key-here!

# Google OAuth 2.0 (for social login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Twitter/X OAuth 2.0 PKCE
# Register https://personnapress.com/api/auth/x/callback in Twitter Dev Portal → App → Auth settings
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=https://personnapress.com/api/auth/x/callback

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://personnapress.com/api/auth/linkedin/callback

# WordPress.com OAuth 2.0
WP_COM_CLIENT_ID=your-wordpress-com-app-id
WP_COM_CLIENT_SECRET=your-wordpress-com-client-secret
WP_COM_REDIRECT_URI=https://personnapress.com/api/auth/wordpress-com/callback

# Stripe (billing)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_live_...
STRIPE_PRICE_GROWTH=price_live_...   # Growth $49/mo recurring — create new price in Stripe Dashboard
STRIPE_PRICE_AGENCY=price_live_...   # Agency $149/mo recurring — create new price in Stripe Dashboard

# AI services
GEMINI_API_KEY=your-gemini-api-key
# Gemini model to use for all AI calls. Default: gemini-2.5-flash (fast + cheap).
# Upgrade to gemini-2.5-pro for higher quality output at higher cost.
# Verify available model IDs at: https://ai.google.dev/models
GEMINI_MODEL=gemini-2.5-flash
# LLM provider for content generation (blog, fidelity check, social posts). "anthropic" | "gemini"
LLM_PROVIDER=anthropic
# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Anthropic model for content generation. Fast options: claude-haiku-4-5-20251001, claude-haiku-4-8
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
REPLICATE_API_TOKEN=r8_...
# Image generation provider. "replicate" | "gemini"
IMAGE_PROVIDER=replicate
# Replicate: google/nano-banana-pro or black-forest-labs/flux-1.1-pro
IMAGE_MODEL=google/nano-banana-pro

# OpenAI Whisper transcription (gpt-4o-mini-transcribe). Get key at platform.openai.com/api-keys
OPENAI_API_KEY=

# Observability
# Get from sentry.io — required for production error tracking
SENTRY_DSN=

# Email (Resend)
RESEND_API_KEY=re_...
# Resend Segment ID — create a Segment in the Resend dashboard (Audiences are deprecated) and paste the UUID here
RESEND_SEGMENT_ID=your-resend-segment-id
# Format must be: "Name <address@domain.com>" — quotes required when sourcing in shell
EMAIL_FROM="PersonnaPress <noreply@personnapress.com>"

# Frontend origin for CORS and OAuth redirect URI construction
# CRITICAL: Must exactly match APP_URL in the frontend .env — including protocol and no trailing slash.
# Used by FastAPI to reconstruct redirect_uri for OAuth token exchange.
APP_URL=https://personnapress.com

# Supabase Storage (for brand content files)
SUPABASE_URL=https://your-project.supabase.co
# WARNING: Service role key bypasses Row Level Security — never expose in client-side code or commit to source control
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Trial period (days)
TRIAL_DAYS=14

# GitHub App (for GitHub Pages blog publishing)
# Register at: https://github.com/settings/apps/new
# Callback URL: https://personnapress.com/api/auth/github/callback
GITHUB_APP_ID=your-numeric-app-id
GITHUB_APP_CLIENT_ID=Iv1.your-string-client-id
# PEM private key — generate in App settings → "Generate a private key"
# Paste the full PEM content (include header/footer lines) or base64-encode it
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret

# Meta Business App (Instagram, Facebook Page, Threads publishing)
# Register at: https://developers.facebook.com/apps/
# Redirect URI: https://personnapress.com/api/auth/meta/callback
# Publishing permissions (already configured): pages_manage_posts, pages_read_engagement,
#   instagram_basic, instagram_content_publish, business_management.
# Post Analytics (Epic 24) additionally requires these insight permissions on the app's
# Facebook Login for Business config (config_id). Each needs Meta App Review before it
# works in production:
#   - read_insights               -> Facebook Page post insights (GET /{post_id}/insights)
#   - instagram_manage_insights   -> Instagram media insights (GET /{ig_media_id}/insights)
# Note: FB Page post insights are only available for Pages with 100+ likes; below that,
# analytics degrades to a "not available" state (no fabricated zeros).
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Threads App (separate credentials from Meta Business App)
# Register at: https://developers.facebook.com/apps/ (under Threads settings)
# Redirect URI: https://personnapress.com/api/auth/threads/callback
# Publishing permission (already configured): threads_content_publish (+ threads_basic).
# Post Analytics (Epic 24) additionally requires the insight permission on the Threads app;
# needs Meta App Review before it works in production:
#   - threads_manage_insights     -> Threads media insights (GET /{media_id}/insights)
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret

# LinkedIn Marketing Developer Platform (MDP) feature gate
# Org scopes (r_organization_admin + w_organization_social) are approved and active.
LINKEDIN_ORG_POSTING_ENABLED=true

# Post analytics (Epic 24) — enables the metrics_poll APScheduler job.
# Default: true (Meta reads are free). Set false to pause harvesting during incidents.
ANALYTICS_ENABLED=true
